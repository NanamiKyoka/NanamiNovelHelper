      },
      {
        "name": "description",
        "type": "string",
        "required": false,
        "description": "新描述"
      },
      {
        "name": "relationTypeId",
        "type": "string",
        "required": false,
        "description": "新关系类型"
      },
      {
        "name": "label",
        "type": "string",
        "required": false,
        "description": "边的新标签"
      }
    ],
    "timeout": 30000
  },
  {
    "id": "relationship_delete",
