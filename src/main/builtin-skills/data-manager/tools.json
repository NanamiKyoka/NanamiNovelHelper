      }
    ],
    "timeout": 30000
  },
  {
    "id": "organization_query",
    "name": "查询组织架构",
    "description": "查询组织架构图、节点、层级关系。",
    "parameters": [
      {
        "name": "action",
        "type": "string",
        "required": false,
        "default": "list_graphs",
        "description": "操作类型",
        "enum": ["list_graphs", "get_graph", "get_node", "get_children", "get_descendants", "get_ancestors", "search_nodes"]
      },
      {
        "name": "graphId",
        "type": "string",
        "required": false,
        "description": "组织架构图 ID"
      },
      {
        "name": "nodeId",
        "type": "string",
        "required": false,
        "description": "节点 ID"
      },
      {
        "name": "parentId",
        "type": "string",
        "required": false,
        "description": "父节点 ID（get_children 时使用，None 表示根节点）"
      },
      {
        "name": "keyword",
        "type": "string",
        "required": false,
        "description": "搜索关键词"
      },
      {
        "name": "asTree",
        "type": "boolean",
        "required": false,
        "default": false,
        "description": "是否返回树形结构"
      }
    ],
    "timeout": 30000
  },
  {
    "id": "organization_add",
    "name": "添加组织架构",
    "description": "创建组织架构图或添加节点。",
    "parameters": [
      {
        "name": "action",
        "type": "string",
        "required": false,
        "default": "create_graph",
        "description": "操作类型",
        "enum": ["create_graph", "add_node"]
      },
      {
        "name": "graphId",
        "type": "string",
        "required": false,
        "description": "组织架构图 ID（add_node 时需要）"
      },
      {
        "name": "name",
        "type": "string",
        "required": true,
        "description": "名称"
      },
      {
        "name": "parentId",
        "type": "string",
        "required": false,
        "description": "父节点 ID（None 表示根节点）"
      },
      {
        "name": "description",
        "type": "string",
        "required": false,
        "description": "描述"
      },
      {
        "name": "createRootNode",
        "type": "boolean",
        "required": false,
        "default": true,
        "description": "是否创建根节点"
      }
    ],
    "timeout": 30000
  },
  {
    "id": "organization_update",
    "name": "更新组织架构",
    "description": "更新组织架构图或节点，支持移动节点。",
    "parameters": [
      {
        "name": "action",
        "type": "string",
        "required": false,
        "default": "update_graph",
        "description": "操作类型",
        "enum": ["update_graph", "update_node", "move_node", "toggle_collapse"]
      },
      {
        "name": "graphId",
        "type": "string",
        "required": true,
        "description": "组织架构图 ID"
      },
      {
        "name": "nodeId",
        "type": "string",
        "required": false,
        "description": "节点 ID"
      },
      {
        "name": "name",
        "type": "string",
        "required": false,
        "description": "新名称"
      },
      {
        "name": "description",
        "type": "string",
        "required": false,
        "description": "新描述"
      },
      {
        "name": "newParentId",
        "type": "string",
        "required": false,
        "description": "新父节点 ID（move_node 时使用）"
      },
      {
        "name": "collapsed",
        "type": "boolean",
        "required": false,
        "description": "折叠状态（toggle_collapse 时使用）"
      }
    ],
    "timeout": 30000
  },
  {
    "id": "organization_delete",
    "name": "删除组织架构",
    "description": "删除组织架构图或节点（包含子节点）。",
    "parameters": [
      {
        "name": "action",
        "type": "string",
        "required": false,
        "default": "delete_graph",
        "description": "操作类型",
        "enum": ["delete_graph", "delete_node"]
      },
      {
        "name": "graphId",
        "type": "string",
        "required": true,
        "description": "组织架构图 ID"
      },
      {
        "name": "nodeId",
        "type": "string",
        "required": false,
        "description": "节点 ID"
      }
    ],
    "timeout": 30000
  },
